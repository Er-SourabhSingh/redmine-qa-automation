# Playwright auth sessions (contain live session tokens)
playwright/.auth/
plugins/*/automation/.auth/

# Playwright automation — installed deps, secrets, run artifacts
plugins/*/automation/node_modules/
scripts/node_modules/
plugins/*/automation/.env
plugins/*/automation/playwright-report/
plugins/*/automation/test-results/
plugins/*/automation/downloads/
plugins/*/automation/screenshots/

# Logs (large, not needed in repo)
plugins/*/logs/

# Portable Node.js + Playwright MCP (local tooling, not committed)
.tools/

# OS files
.DS_Store
Thumbs.db

# MCP config — contains a live production API key
.mcp.json
.playwright-mcp/

# Mail server runtime state (mailboxes, logs, postfix sockets/pids) —
# not portable, regenerated by the containers, and includes special files
# (unix sockets) git can't even hash
scripts/mail-server/docker-data/
