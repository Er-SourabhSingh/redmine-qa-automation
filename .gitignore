# Playwright auth sessions (contain live session tokens)
playwright/.auth/
plugins/*/automation/.auth/

# Playwright automation — installed deps, secrets, run artifacts
plugins/*/automation/node_modules/
scripts/node_modules/
plugins/*/automation/.env
plugins/*/automation/playwright-report/
plugins/*/automation/test-results/
plugins/*/automation/downloads/
plugins/*/automation/screenshots/

# Logs and screenshots (large, not needed in repo)
plugins/*/logs/
plugins/*/screenshots/

# Generated per-bug PDFs for production attachment — regenerable from bugs/open|closed/*.md
plugins/*/bugs/pdf/

# OS files
.DS_Store
Thumbs.db

# MCP config — contains a live production API key
.mcp.json
.playwright-mcp/
