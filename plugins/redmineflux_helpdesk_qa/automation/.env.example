# Copy this file to .env and fill in values from the active credentials file:
#   QA_CREDENTIALS_LOCAL.md  (ENVIRONMENT=local)
#   QA_CREDENTIALS_FORGE.md  (ENVIRONMENT=forge)
#
# Never commit the real .env file. Never hardcode these values in test/page-object code.

ENVIRONMENT=local
BASE_URL=http://localhost:3006

ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678

MANAGER_USERNAME=
MANAGER_PASSWORD=

DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=

QA_ENGINEER_USERNAME=
QA_ENGINEER_PASSWORD=

CLIENT_USERNAME=
CLIENT_PASSWORD=
